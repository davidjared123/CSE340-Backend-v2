<%- include('partials/header') %>

<h1><%= project.title %></h1>
<p><strong>Description:</strong> <%= project.description %></p>
<p><strong>Date:</strong> <%= project.date.toLocaleDateString() %></p>
<p><strong>Location:</strong> <%= project.location %></p>
<p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
<p><strong>Categories:</strong> 
    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>"><%= category.name %></a> 
        <% }) %>
    <% } else { %>
        None
    <% } %>
</p>

<% if (user && user.role_name === 'admin') { %>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project Details</a></p>
<% } %>

<%- include('partials/footer') %>
