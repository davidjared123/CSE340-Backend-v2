<%- include('partials/header') %>

<h1><%= title %></h1>
<p>These are our current projects.</p>
<ul>
    <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= project.date.toLocaleDateString() %>:</strong> 
                <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
            </li>
        <% }) %>
    <% } else { %>
        <li>No service projects available at the moment.</li>
    <% } %>
</ul>

<p><a href="/new-project">Add a new project</a></p>

<%- include('partials/footer') %>
